[Unit]
Description=Codex Desktop upstream DMG watchdog (probe + repair dispatch)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Run directly from the repo, outside any Codex automation sandbox.
ExecStart=/home/michael/dev/tools/codex-desktop-linux/scripts/automation/upstream-dmg-watchdog/run-watchdog.sh
Environment=WATCHDOG_LOG_FILE=%h/.local/state/codex-automations/upstream-dmg-watchdog/runner.log
Environment=WATCHDOG_MODEL=clinepass/cline-pass/deepseek-v4-flash
Environment=WATCHDOG_REASONING=minimal
# The worker is dispatched via the opencode client (cheap deepseek models).
Environment=WATCHDOG_WORKER_CLI=openclaw
# Dispatch the worker detached (nohup) so the service returns immediately and
# the worker is not killed by a parent timeout. Completion is recorded via a
# chatrap-style signal under WATCHDOG_SIGNAL_DIR.
Environment=WATCHDOG_DISPATCH_MODE=background
Environment=WATCHDOG_SIGNAL_DIR=%h/.local/state/codex-automations/upstream-dmg-watchdog/signals
Environment=WATCHDOG_ALERT_EMAIL=michael@localhost
# Option C: also deliver success/failure notifications to the OpenClaw Discord
# channel (the one already wired in openclaw's commands.ownerAllowFrom).
Environment=WATCHDOG_NOTIFY_CHANNEL=discord
Environment=WATCHDOG_NOTIFY_TARGET=788869918954750012
# The worker needs full local filesystem access to read/write the repo.
Environment=WATCHDOG_STATE_DIR=%h/.local/state/codex-automations/upstream-dmg-watchdog

# Long timeout: the worker repair (build + patch re-target) can take a while.
TimeoutStartSec=0
Restart=on-failure
RestartSec=60

[Install]
WantedBy=timers.target